//@version=6
strategy("Fib Strategy v2", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=2,
         commission_type=strategy.commission.percent, commission_value=0.02,
         slippage=1, max_bars_back=500,
         max_lines_count=100, max_labels_count=50, max_boxes_count=20)

// ─── Inputs ───────────────────────────────────────────────────────────────────
pivLeft  = input.int(5,    "Pivot Left Bars",             minval=1,    group="Pivots")
pivRight = input.int(5,    "Pivot Right Bars",            minval=1,    group="Pivots")
slBuf    = input.float(0.05, "SL Buffer % beyond pivot",  minval=0, step=0.01, group="Risk")

useVol       = input.bool(false, "Require Volume Spike",      group="Filters")
volLen       = input.int(20,    "Vol Avg Length",  minval=1,  group="Filters")
volMult      = input.float(2.0, "Vol Spike Mult",  minval=1.0, step=0.1, group="Filters")
showVolColor = input.bool(true,  "Color vol spike candles",    group="Filters")
colVolSpike  = input.color(color.new(color.purple, 50), "Vol spike color", group="Filters")

// ─── Volume ───────────────────────────────────────────────────────────────────
avgVol   = ta.sma(volume, volLen)
volSpike = volume > avgVol * volMult
barcolor(showVolColor and volSpike ? colVolSpike : na)

// ─── Pivot Detection ──────────────────────────────────────────────────────────
pivH = ta.pivothigh(high, pivLeft, pivRight)
pivL = ta.pivotlow(low,  pivLeft, pivRight)

var float lastPH    = na
var int   lastPHBar = na
var float lastPL    = na
var int   lastPLBar = na

if not na(pivH)
    lastPH    := pivH
    lastPHBar := bar_index - pivRight

if not na(pivL)
    lastPL    := pivL
    lastPLBar := bar_index - pivRight

// ─── Setup ────────────────────────────────────────────────────────────────────
hasPivots = not na(lastPH) and not na(lastPL)
rng       = hasPivots ? lastPH - lastPL : na

// Trend determined by which pivot formed most recently:
//   last pivot = HIGH → uptrend retracement → look for long at GP/786
//   last pivot = LOW  → downtrend bounce    → look for short at GP/786
uptrend   = hasPivots and lastPHBar > lastPLBar
downtrend = hasPivots and lastPLBar > lastPHBar

// Long levels: price pulls back from the high toward the low
longGP_hi = hasPivots ? lastPH - rng * 0.618 : na  // top of GP zone
longGP_lo = hasPivots ? lastPH - rng * 0.650 : na  // bottom of GP zone
long786   = hasPivots ? lastPH - rng * 0.786 : na
longTP    = hasPivots ? lastPH - rng * 0.236 : na  // TP at 0.236
longSL    = hasPivots ? lastPL  * (1 - slBuf / 100) : na  // below pivot low

// Short levels: price bounces up from the low toward the high
shortGP_lo = hasPivots ? lastPL + rng * 0.618 : na  // bottom of GP zone
shortGP_hi = hasPivots ? lastPL + rng * 0.650 : na  // top of GP zone
short786   = hasPivots ? lastPL + rng * 0.786 : na
shortTP    = hasPivots ? lastPL + rng * 0.236 : na  // TP at 0.236
shortSL    = hasPivots ? lastPH * (1 + slBuf / 100) : na  // above pivot high

// ─── Zone Touch ───────────────────────────────────────────────────────────────
longGPz   = hasPivots and low <= longGP_hi  and high >= longGP_lo
long786z  = hasPivots and low <= long786    and high >= long786
shortGPz  = hasPivots and high >= shortGP_lo and low <= shortGP_hi
short786z = hasPivots and high >= short786   and low <= short786

// ─── Entry Conditions ─────────────────────────────────────────────────────────
longEntry  = uptrend   and (longGPz  or long786z)  and (not useVol or volSpike) and strategy.position_size == 0
shortEntry = downtrend and (shortGPz or short786z) and (not useVol or volSpike) and strategy.position_size == 0

// ─── Trade Execution ──────────────────────────────────────────────────────────
if longEntry
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry="Long", stop=longSL, limit=longTP)

if shortEntry
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry="Short", stop=shortSL, limit=shortTP)

// ─── Visualization ────────────────────────────────────────────────────────────
var line ln_gpTop = na
var line ln_gpBot = na
var line ln_786   = na
var line ln_tp    = na
var line ln_sl    = na
var line ln_pivH  = na
var line ln_pivL  = na
var box  bx_gp    = na

if (not na(pivH) or not na(pivL)) and hasPivots
    line.delete(ln_gpTop), line.delete(ln_gpBot), line.delete(ln_786)
    line.delete(ln_tp),    line.delete(ln_sl)
    line.delete(ln_pivH),  line.delete(ln_pivL)
    box.delete(bx_gp)

    lft = math.min(lastPHBar, lastPLBar) - 5

    ln_pivH := line.new(lastPHBar, lastPH, bar_index + 1, lastPH, extend=extend.right, color=color.red,   width=1, style=line.style_dashed)
    ln_pivL := line.new(lastPLBar, lastPL, bar_index + 1, lastPL, extend=extend.right, color=color.green, width=1, style=line.style_dashed)

    if uptrend
        bx_gp    := box.new(lft, longGP_hi, bar_index + 1, longGP_lo, bgcolor=color.new(color.aqua, 85), border_color=color.new(color.aqua, 60), extend=extend.right)
        ln_gpTop := line.new(lft, longGP_hi, bar_index + 1, longGP_hi, extend=extend.right, color=color.aqua,   width=1)
        ln_gpBot := line.new(lft, longGP_lo, bar_index + 1, longGP_lo, extend=extend.right, color=color.aqua,   width=1)
        ln_786   := line.new(lft, long786,   bar_index + 1, long786,   extend=extend.right, color=color.yellow, width=1)
        ln_tp    := line.new(lft, longTP,    bar_index + 1, longTP,    extend=extend.right, color=color.lime,   width=1, style=line.style_dotted)
        ln_sl    := line.new(lft, longSL,    bar_index + 1, longSL,    extend=extend.right, color=color.red,    width=1, style=line.style_dotted)

    if downtrend
        bx_gp    := box.new(lft, shortGP_hi, bar_index + 1, shortGP_lo, bgcolor=color.new(color.orange, 85), border_color=color.new(color.orange, 60), extend=extend.right)
        ln_gpTop := line.new(lft, shortGP_hi, bar_index + 1, shortGP_hi, extend=extend.right, color=color.orange, width=1)
        ln_gpBot := line.new(lft, shortGP_lo, bar_index + 1, shortGP_lo, extend=extend.right, color=color.orange, width=1)
        ln_786   := line.new(lft, short786,   bar_index + 1, short786,   extend=extend.right, color=color.yellow, width=1)
        ln_tp    := line.new(lft, shortTP,    bar_index + 1, shortTP,    extend=extend.right, color=color.lime,   width=1, style=line.style_dotted)
        ln_sl    := line.new(lft, shortSL,    bar_index + 1, shortSL,    extend=extend.right, color=color.red,    width=1, style=line.style_dotted)

// ─── Entry Markers ────────────────────────────────────────────────────────────
plotshape(longEntry,  "Long",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(shortEntry, "Short", shape.triangledown,  location.abovebar, color.red,  size=size.small)

// ─── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(longEntry,  "Long Entry",  "Fib Long: {{ticker}} @ {{close}}")
alertcondition(shortEntry, "Short Entry", "Fib Short: {{ticker}} @ {{close}}")
