//@version=6
strategy("ORB Breakout  |  NQ / ES", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=2,
         commission_type=strategy.commission.percent, commission_value=0.02,
         slippage=2, max_bars_back=500,
         process_orders_on_close=true)

// ── Inputs ────────────────────────────────────────────────────────────────────
i_orbWin    = input.string("30min", "ORB Window",
                 options=["15min","30min","60min"],                             group="ORB")
i_rr        = input.float(2.0,   "Reward : Risk",    minval=0.5, step=0.25,   group="Risk")
i_minRng    = input.float(10.0,  "Min Range (pts)",  minval=0,                 group="Risk")
i_maxRng    = input.float(500.0, "Max Range (pts)",  minval=0,                 group="Risk")
i_volFilter = input.bool(true,   "Volume Spike",                               group="Filters")
i_volMult   = input.float(1.5,   "  Multiplier",     minval=1.0, step=0.1,    group="Filters")
i_rsiFilter = input.bool(true,   "RSI Momentum",                               group="Filters")
i_gapFilter = input.bool(true,   "Gap-Direction Bias",                         group="Filters")
i_dir       = input.string("Both","Trade Direction",
                 options=["Both","Long Only","Short Only"],                     group="Filters")
i_debug     = input.bool(false,  "Session Colors",                             group="Display")

// ── Session Windows (America/New_York) ────────────────────────────────────────
TZ        = "America/New_York"
orbSess   = i_orbWin == "15min" ? "0930-0945:23456" :
            i_orbWin == "60min" ? "0930-1030:23456" : "0930-1000:23456"
tradeSess = i_orbWin == "15min" ? "0945-1530:23456" :
            i_orbWin == "60min" ? "1030-1530:23456" : "1000-1530:23456"
fullSess  = "0930-1600:23456"

inORB      = not na(time(timeframe.period, orbSess,   TZ))
inTrade    = not na(time(timeframe.period, tradeSess, TZ))
inFullSess = not na(time(timeframe.period, fullSess,  TZ))
newDay     = inORB and not inORB[1]

// ── ORB State ─────────────────────────────────────────────────────────────────
var float orbHigh    = na
var float orbLow     = na
var float orbOpen    = na
var int   orbStartBr = na
var bool  orbLocked  = false
var bool  longTaken  = false
var bool  shortTaken = false

if newDay
    orbHigh    := high
    orbLow     := low
    orbOpen    := open
    orbStartBr := bar_index
    orbLocked  := false
    longTaken  := false
    shortTaken := false

if inORB and not orbLocked
    orbHigh := math.max(nz(orbHigh, high), high)
    orbLow  := math.min(nz(orbLow,  low),  low)

// Lock ORB on the first bar after the opening range window closes
if inORB[1] and not inORB and not orbLocked and not na(orbHigh)
    orbLocked := true

// ── Derived Values ────────────────────────────────────────────────────────────
orbRange = orbHigh - orbLow
orbMid   = (orbHigh + orbLow) / 2.0
orbValid = orbLocked and orbRange >= i_minRng and orbRange <= i_maxRng

// ── Gap Direction (prior day close vs today's open) ───────────────────────────
prevDayClose = request.security(syminfo.tickerid, "D", close[1],
                 lookahead=barmerge.lookahead_off)
gapUp   = not na(prevDayClose) and not na(orbOpen) and orbOpen > prevDayClose
gapDown = not na(prevDayClose) and not na(orbOpen) and orbOpen < prevDayClose

// ── Confirmation Filters ──────────────────────────────────────────────────────
volAvg   = ta.sma(volume, 20)
volSpike = volume > volAvg * i_volMult
rsi14    = ta.rsi(close, 14)

longConf   = (not i_volFilter or volSpike) and (not i_rsiFilter or rsi14 > 50)
shortConf  = (not i_volFilter or volSpike) and (not i_rsiFilter or rsi14 < 50)
longGapOk  = not i_gapFilter or gapUp   or (not gapUp and not gapDown)
shortGapOk = not i_gapFilter or gapDown or (not gapUp and not gapDown)

// ── Entry Signals (close confirmation — no wick fakes) ────────────────────────
noPos      = strategy.position_size == 0
longBreak  = orbValid and inTrade and close > orbHigh and not longTaken  and noPos
shortBreak = orbValid and inTrade and close < orbLow  and not shortTaken and noPos and not longBreak

longEntry  = longBreak  and longConf  and longGapOk  and i_dir != "Short Only"
shortEntry = shortBreak and shortConf and shortGapOk and i_dir != "Long Only"

// ── Stop & Target (ORB boundary SL, fixed R:R TP) ─────────────────────────────
longSL  = orbLow
longTP  = close + (close - orbLow)   * i_rr
shortSL = orbHigh
shortTP = close - (orbHigh - close)  * i_rr

// ── Execution ─────────────────────────────────────────────────────────────────
if longEntry
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", "Long", stop=longSL, limit=longTP)
    longTaken := true

if shortEntry
    strategy.entry("Short", strategy.short)
    strategy.exit("SX", "Short", stop=shortSL, limit=shortTP)
    shortTaken := true

// ── Visualization ─────────────────────────────────────────────────────────────
// Session background
bgcolor(i_debug and inORB   ? color.new(color.blue,  90) : na)
bgcolor(i_debug and inTrade ? color.new(color.green, 96) : na)

// ORB building box — grows live during the opening range window
var box orbBox = na
if newDay
    box.delete(orbBox)
    orbBox := box.new(bar_index, high, bar_index + 1, low,
         bgcolor=color.new(color.blue, 82),
         border_color=color.new(color.blue, 40),
         border_width=1)

if inORB and not na(orbBox)
    box.set_top(orbBox,    orbHigh)
    box.set_bottom(orbBox, orbLow)
    box.set_right(orbBox,  bar_index + 1)

// Locked ORB levels — flat lines drawn only during regular session hours
plot(orbLocked and inFullSess ? orbHigh : na, "ORB High",
     color=color.red,                 linewidth=2, style=plot.style_linebr)
plot(orbLocked and inFullSess ? orbLow  : na, "ORB Low",
     color=color.lime,                linewidth=2, style=plot.style_linebr)
plot(orbLocked and inFullSess ? orbMid  : na, "ORB Mid",
     color=color.new(color.gray, 50), linewidth=1, style=plot.style_linebr)

// Entry markers
plotshape(longEntry,  "Long",  shape.triangleup,   location.belowbar, color.lime, size=size.normal)
plotshape(shortEntry, "Short", shape.triangledown,  location.abovebar, color.red,  size=size.normal)

// ── Dashboard ─────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7,
     bgcolor=color.new(color.black, 70),
     border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "ORB",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, orbLocked ? "LOCKED" : inORB ? "BUILDING" : "—",
         text_color=orbLocked ? color.lime : color.orange, text_size=size.small)
    table.cell(dash, 0, 1, "High",    text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, not na(orbHigh) ? str.tostring(orbHigh, "#.##") : "—",
         text_color=color.red, text_size=size.small)
    table.cell(dash, 0, 2, "Low",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, not na(orbLow)  ? str.tostring(orbLow, "#.##") : "—",
         text_color=color.lime, text_size=size.small)
    table.cell(dash, 0, 3, "Range",   text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, orbLocked  ? str.tostring(orbRange, "#.##") + " pts" : "—",
         text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Gap",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, gapUp ? "UP ▲" : gapDown ? "DN ▼" : "FLAT —",
         text_color=gapUp ? color.lime : gapDown ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 5, "Vol",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, volSpike ? "SPIKE ✓" : "low",
         text_color=volSpike ? color.lime : color.gray, text_size=size.small)
    table.cell(dash, 0, 6, "Session", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, inTrade ? "ACTIVE" : "—",
         text_color=inTrade ? color.lime : color.gray, text_size=size.small)

// ── Alerts ────────────────────────────────────────────────────────────────────
alertcondition(longEntry,  "ORB Long",  "ORB Long: {{ticker}} closed above ORB high @ {{close}}")
alertcondition(shortEntry, "ORB Short", "ORB Short: {{ticker}} closed below ORB low @ {{close}}")
