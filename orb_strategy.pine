//@version=6
strategy("ORB Breakout  |  NQ / ES", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=2,
         commission_type=strategy.commission.percent, commission_value=0.02,
         slippage=2, max_bars_back=500,
         process_orders_on_close=true)

// ── ORB ───────────────────────────────────────────────────────────────────────
i_orbWin = input.string("30min", "ORB Window",  options=["15min","30min"], group="ORB")
i_amOnly = input.bool(true, "Morning only (stop entries at 1 PM ET)",      group="ORB")

// ── Risk ──────────────────────────────────────────────────────────────────────
i_rr     = input.float(1.5,  "Reward : Risk",       minval=0.5, step=0.25, group="Risk")
i_slBuf  = input.float(0.5,  "SL Buffer (ATR mult)", minval=0.1, step=0.1, group="Risk")
i_minRng = input.float(10.0, "Min ORB Range (pts)",  minval=0,              group="Risk")
i_maxRng = input.float(500.0,"Max ORB Range (pts)",  minval=0,              group="Risk")

// ── Filters ───────────────────────────────────────────────────────────────────
i_trendFilter = input.bool(true,  "Daily EMA Trend Filter",                    group="Filters")
i_trendEMA    = input.int(20,     "  EMA Period",  minval=5, maxval=200,        group="Filters")
i_volFilter   = input.bool(true,  "Volume Spike",                               group="Filters")
i_volMult     = input.float(1.2,  "  Multiplier",  minval=1.0, step=0.1,        group="Filters")
i_rsiFilter   = input.bool(true,  "RSI Momentum",                               group="Filters")
i_gapFilter   = input.bool(true,  "Gap Direction Bias",                         group="Filters")
i_dir         = input.string("Both","Trade Direction", options=["Both","Long Only","Short Only"], group="Filters")

// ── Colors ────────────────────────────────────────────────────────────────────
i_boxBg    = input.color(color.new(color.blue,   82), "ORB Box Fill",       group="Colors")
i_boxBdr   = input.color(color.new(color.blue,   40), "ORB Box Border",     group="Colors")
i_colHigh  = input.color(color.red,                   "ORB High Line",      group="Colors")
i_colLow   = input.color(color.lime,                  "ORB Low Line",       group="Colors")
i_colMid   = input.color(color.new(color.gray,  50),  "ORB Mid Line",       group="Colors")
i_colLong  = input.color(color.lime,                  "Long Signal",        group="Colors")
i_colShort = input.color(color.red,                   "Short Signal",       group="Colors")
i_colArmed = input.color(color.new(color.yellow, 50), "Armed (watching)",   group="Colors")

// ── Display ───────────────────────────────────────────────────────────────────
i_showArmed = input.bool(true,  "Show Armed Dots",     group="Display")
i_showLabel = input.bool(true,  "Show Entry Labels",   group="Display")
i_debug     = input.bool(false, "Show Session Colors", group="Display")

// ── Sessions — all time() calls use constant strings ──────────────────────────
_inORB15   = not na(time(timeframe.period, "0930-0945:23456", "America/New_York"))
_inORB30   = not na(time(timeframe.period, "0930-1000:23456", "America/New_York"))
_inTrd15am = not na(time(timeframe.period, "0945-1300:23456", "America/New_York"))
_inTrd30am = not na(time(timeframe.period, "1000-1300:23456", "America/New_York"))
_inTrd15pm = not na(time(timeframe.period, "0945-1530:23456", "America/New_York"))
_inTrd30pm = not na(time(timeframe.period, "1000-1530:23456", "America/New_York"))
_inFull    = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))

inORB      = i_orbWin == "15min" ? _inORB15 : _inORB30
inTrade    = i_orbWin == "15min" ? (i_amOnly ? _inTrd15am : _inTrd15pm) : (i_amOnly ? _inTrd30am : _inTrd30pm)
inFullSess = _inFull
newDay     = inORB and not inORB[1]

// ── ORB State ─────────────────────────────────────────────────────────────────
var float orbHigh    = na
var float orbLow     = na
var float orbOpen    = na
var int   orbStartBr = na
var bool  orbLocked  = false
var bool  longTaken  = false
var bool  shortTaken = false

if newDay
    orbHigh    := high
    orbLow     := low
    orbOpen    := open
    orbStartBr := bar_index
    orbLocked  := false
    longTaken  := false
    shortTaken := false

if inORB and not orbLocked
    orbHigh := math.max(nz(orbHigh, high), high)
    orbLow  := math.min(nz(orbLow,  low),  low)

if inORB[1] and not inORB and not orbLocked and not na(orbHigh)
    orbLocked := true

// ── Derived ───────────────────────────────────────────────────────────────────
orbRange = orbHigh - orbLow
orbMid   = (orbHigh + orbLow) / 2.0
orbValid = orbLocked and orbRange >= i_minRng and orbRange <= i_maxRng

// ── Daily Trend Filter ────────────────────────────────────────────────────────
// Prevents taking long ORBs in a downtrend and short ORBs in an uptrend —
// the single biggest improvement: only trade with the daily structure
dailyEMA  = request.security(syminfo.tickerid, "D", ta.ema(close, i_trendEMA), lookahead=barmerge.lookahead_off)
trendBull = not i_trendFilter or close > dailyEMA
trendBear = not i_trendFilter or close < dailyEMA

// ── Gap Direction ─────────────────────────────────────────────────────────────
prevDayClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
gapUp   = not na(prevDayClose) and not na(orbOpen) and orbOpen > prevDayClose
gapDown = not na(prevDayClose) and not na(orbOpen) and orbOpen < prevDayClose

// ── Indicators ────────────────────────────────────────────────────────────────
atr14    = ta.atr(14)
volAvg   = ta.sma(volume, 20)
volSpike = volume > volAvg * i_volMult
rsi14    = ta.rsi(close, 14)

// ── Confirmation ──────────────────────────────────────────────────────────────
longConf   = (not i_volFilter or volSpike) and (not i_rsiFilter or rsi14 > 50)
shortConf  = (not i_volFilter or volSpike) and (not i_rsiFilter or rsi14 < 50)
longGapOk  = not i_gapFilter or gapUp or (not gapUp and not gapDown)
shortGapOk = not i_gapFilter or gapDown or (not gapUp and not gapDown)

// ── Armed State ───────────────────────────────────────────────────────────────
noPos      = strategy.position_size == 0
rsiOkLong  = not i_rsiFilter or rsi14 > 50
rsiOkShort = not i_rsiFilter or rsi14 < 50
armedLong  = orbValid and inTrade and not longTaken  and noPos and rsiOkLong  and longGapOk  and trendBull and i_dir != "Short Only" and close <= orbHigh
armedShort = orbValid and inTrade and not shortTaken and noPos and rsiOkShort and shortGapOk and trendBear and i_dir != "Long Only"  and close >= orbLow and not armedLong

// ── Entry Signals ─────────────────────────────────────────────────────────────
longBreak  = orbValid and inTrade and close > orbHigh and not longTaken  and noPos
shortBreak = orbValid and inTrade and close < orbLow  and not shortTaken and noPos and not longBreak
longEntry  = longBreak  and longConf  and longGapOk  and trendBull and i_dir != "Short Only"
shortEntry = shortBreak and shortConf and shortGapOk and trendBear and i_dir != "Long Only"

// ── Stops and Targets ─────────────────────────────────────────────────────────
// SL is ATR-based from entry — tight and consistent regardless of ORB width.
// i_slBuf controls how many ATRs below/above the entry close the stop sits.
longSL  = close - atr14 * i_slBuf
longTP  = close + (close - longSL) * i_rr
shortSL = close + atr14 * i_slBuf
shortTP = close - (shortSL - close) * i_rr

// ── Execution ─────────────────────────────────────────────────────────────────
if longEntry
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", "Long", stop=longSL, limit=longTP)
    longTaken := true
    alert("ORB LONG " + syminfo.ticker + " | Entry: " + str.tostring(close, "#.##") + " SL: " + str.tostring(longSL, "#.##") + " TP: " + str.tostring(longTP, "#.##") + " | Range: " + str.tostring(orbRange, "#.0") + "pts", alert.freq_once_per_bar_close)

if shortEntry
    strategy.entry("Short", strategy.short)
    strategy.exit("SX", "Short", stop=shortSL, limit=shortTP)
    shortTaken := true
    alert("ORB SHORT " + syminfo.ticker + " | Entry: " + str.tostring(close, "#.##") + " SL: " + str.tostring(shortSL, "#.##") + " TP: " + str.tostring(shortTP, "#.##") + " | Range: " + str.tostring(orbRange, "#.0") + "pts", alert.freq_once_per_bar_close)

// ── Visualization ─────────────────────────────────────────────────────────────
bgcolor(i_debug and inORB   ? color.new(color.blue,  90) : na)
bgcolor(i_debug and inTrade ? color.new(color.green, 96) : na)

var box orbBox = na
if newDay
    box.delete(orbBox)
    orbBox := box.new(bar_index, high, bar_index + 1, low, bgcolor=i_boxBg, border_color=i_boxBdr, border_width=1)

if inORB and not na(orbBox)
    box.set_top(orbBox,    orbHigh)
    box.set_bottom(orbBox, orbLow)
    box.set_right(orbBox,  bar_index + 1)

plot(orbLocked and inFullSess ? orbHigh : na, "ORB High", color=i_colHigh, linewidth=2, style=plot.style_linebr)
plot(orbLocked and inFullSess ? orbLow  : na, "ORB Low",  color=i_colLow,  linewidth=2, style=plot.style_linebr)
plot(orbLocked and inFullSess ? orbMid  : na, "ORB Mid",  color=i_colMid,  linewidth=1, style=plot.style_linebr)
plot(orbLocked and inFullSess ? dailyEMA : na, "Daily EMA", color=color.new(color.purple, 30), linewidth=1, style=plot.style_linebr)

plotchar(i_showArmed and armedLong,  "Armed Long",  "o", location.belowbar, i_colArmed, size=size.tiny)
plotchar(i_showArmed and armedShort, "Armed Short", "o", location.abovebar, i_colArmed, size=size.tiny)

plotshape(longEntry,  "Long",  shape.triangleup,   location.belowbar, i_colLong,  size=size.normal)
plotshape(shortEntry, "Short", shape.triangledown,  location.abovebar, i_colShort, size=size.normal)

if i_showLabel and longEntry
    label.new(bar_index, low - atr14, "LONG\nEntry " + str.tostring(close, "#.##") + "\nSL    " + str.tostring(longSL, "#.##") + "\nTP    " + str.tostring(longTP, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(i_colLong, 70), textcolor=color.white, size=size.small)

if i_showLabel and shortEntry
    label.new(bar_index, high + atr14, "SHORT\nEntry " + str.tostring(close, "#.##") + "\nSL    " + str.tostring(shortSL, "#.##") + "\nTP    " + str.tostring(shortTP, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(i_colShort, 70), textcolor=color.white, size=size.small)

// ── Dashboard ─────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 70), border_color=color.new(color.gray, 50), border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "ORB",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, orbLocked ? "LOCKED" : inORB ? "BUILDING" : "-", text_color=orbLocked ? color.lime : color.orange, text_size=size.small)
    table.cell(dash, 0, 1, "High",    text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, not na(orbHigh) ? str.tostring(orbHigh, "#.##") : "-", text_color=i_colHigh, text_size=size.small)
    table.cell(dash, 0, 2, "Low",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, not na(orbLow)  ? str.tostring(orbLow,  "#.##") : "-", text_color=i_colLow,  text_size=size.small)
    table.cell(dash, 0, 3, "Range",   text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, orbLocked  ? str.tostring(orbRange, "#.0") + " pts" : "-", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "Trend",   text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, not i_trendFilter ? "off" : trendBull ? "BULL" : "BEAR", text_color=not i_trendFilter ? color.gray : trendBull ? color.lime : color.red, text_size=size.small)
    table.cell(dash, 0, 5, "Gap",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, not i_gapFilter ? "off" : gapUp ? "UP" : gapDown ? "DN" : "FLAT", text_color=not i_gapFilter ? color.gray : gapUp ? color.lime : gapDown ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 6, "Volume",  text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, not i_volFilter ? "off" : volSpike ? "SPIKE" : "low", text_color=not i_volFilter ? color.gray : volSpike ? color.lime : color.red, text_size=size.small)
    table.cell(dash, 0, 7, "RSI",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, not i_rsiFilter ? "off" : str.tostring(rsi14, "#.0"), text_color=not i_rsiFilter ? color.gray : rsi14 > 50 ? color.lime : color.red, text_size=size.small)
    table.cell(dash, 0, 8, "Armed",   text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, armedLong ? "LONG" : armedShort ? "SHORT" : "-", text_color=armedLong ? color.lime : armedShort ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 9, "Session", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, inTrade ? "ACTIVE" : "-", text_color=inTrade ? color.lime : color.gray, text_size=size.small)

// ── Alerts ────────────────────────────────────────────────────────────────────
alertcondition(longEntry,  "ORB Long",  "ORB Long: {{ticker}} @ {{close}}")
alertcondition(shortEntry, "ORB Short", "ORB Short: {{ticker}} @ {{close}}")
